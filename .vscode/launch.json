{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Wails: Debug myproject",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/build/bin/nvim-gui",
      "preLaunchTask": "build",
      "cwd": "${workspaceFolder}",
      "env": {}
    },
{
  "name": "Attach Wails",
  "type": "go",
  "request": "attach",
  "mode": "local",
  "processId": "${command:pickProcess}"
}
  ]
}